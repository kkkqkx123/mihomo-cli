# TOML 配置示例，安装时复制到用户目录，不会被仓库位置自动加载
# 生效位置为 <UserConfigDir>/mihomo-cli/config.toml，另可用 --toml 显式指定
#
# [mihomo] executable 留空时从系统 PATH 查找 mihomo；
# [mihomo] config_file 留空时直接启动 mihomo，由内核使用默认配置
# （默认位置为 ~/.config/mihomo/config.yaml，可用 -d 或内核配置文件调整）。
# [api] address/secret 必须与内核的 external-controller/secret 一致。

[api]
address = "http://127.0.0.1:9090"
secret = ""
timeout = 10

[mihomo]
enabled = true
executable = ""
config_file = ""
health_check_timeout = 5
