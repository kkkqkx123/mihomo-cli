[Unit]
Description=Mihomo proxy core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@BIN@/mihomo -d @MIHOMO_HOME@ -f @MIHOMO_HOME@/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
LimitNOFILE=1000000

[Install]
WantedBy=@TARGET@
